# ── Reference clones (local only; never track) ──
/reference/

# ── Secrets ──
.env
.env.*
!.env.example
**/credentials.json
**/config.local.json
**/info.txt
**/secrets/

# ── Local product docs / research (keep on disk; not for public remote) ──
/docs/

# Browser HTTP dumps at repo root (contain live session Cookie / ticket)
/*_Full.txt
.tmp_68_extract/

# ── AI tool caches (rules under .cursor/rules are tracked) ──
.claude/
.codegraph/
.cursor/*.log
.cursor/settings.local.json
.claude/settings.local.json

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Local tool caches (portable NSIS, etc.)
.tools/

# Flutter/Dart/Pub related
